# Copy to .env and fill in what you need. Everything has a default.

# --- Chat model (any OpenAI-compatible API) -------------------------------
# Leave LLM_API_KEY and LLM_BASE_URL empty to run in extractive mode (no AI model:
# answers quote the most relevant sentences, with citations).

# OpenAI
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5-mini

# Groq (free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=<a chat model id from https://console.groq.com/docs/models>

# Google Gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...
# LLM_MODEL=<a model id from https://ai.google.dev/gemini-api/docs/models>

# Ollama (local, no key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<a model you have pulled, e.g. from `ollama list`>

# --- Embeddings -------------------------------------------------------------
# "local" runs BAAI/bge-small-en-v1.5 on your CPU for free (needs: uv sync --extra local)
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
